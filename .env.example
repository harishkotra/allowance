# --- Inference: default is Particle.ai (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.particle.ai/v1
OPENAI_API_KEY=pa-xxxxxxxx
MODEL=deepseek-v4.1-flash

# --- Optional add-ons the Settings panel offers ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

# --- Envelope defaults (overridable in the UI) ---
CAP_TOKENS=40000
CAP_USD=0.25
CAP_SECONDS=90
APPROVE_UNDER_USD=0.05     # auto-approve tier
NEGOTIATE=true             # allow the agent to request more budget
PRICE_PER_1K_INPUT=0.00015 # $ per 1k input tokens (edit to match your provider)
PRICE_PER_1K_OUTPUT=0.0006 # $ per 1k output tokens

INNGEST_DEV=1
LEDGER_DB=./allowance.db
PORT=3001
