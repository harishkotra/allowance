{
  "name": "allowance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An agent that runs inside a hard spend envelope of tokens, dollars and wall-clock time.",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/api.ts",
    "dev:client": "vite client --port 5173 --host 127.0.0.1",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "inngest": "inngest-cli dev -p 8288 -u http://127.0.0.1:${PORT:-3001}/api/inngest",
    "start": "tsx --env-file-if-exists=.env server/src/api.ts",
    "build": "npm run typecheck && vite build client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/test/*.test.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@inngest/agent-kit": "^0.13.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "gpt-tokenizer": "^4.0.0",
    "inngest": "^4.21.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "inngest-cli": "^1.45.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
